# Copy this file to .env and fill in keys you have. Never commit .env.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
STOCKDATA_API_KEY=
EODHD_API_KEY=

# Optional model source. Prefer local MODEL_PATH for your trained model.
# MODEL_PATH=models/finbert_model
# MODEL_ID=your-private-huggingface-org/your-model
HF_TOKEN=

# Shared settings
DEFAULT_SYMBOL=AAPL
NEWS_LIMIT_PER_SOURCE=10
NEWS_REQUEST_TIMEOUT=15
NEWS_LOOKBACK_HOURS=24          # also the ingestor's "too old" cutoff
NEWS_HALF_LIFE_HOURS=6
DEFAULT_NEWS_LANGUAGE=en
MARKET_REQUEST_TIMEOUT=15
REFRESH_INTERVAL_SECONDS=10     # dashboard refresh

# Streaming pipeline (primary path)
WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META   # symbols must exist in news_service.COMPANIES
INGEST_INTERVAL_SECONDS=300
SIGNAL_REFRESH_S=60
MARKETPULSE_DB=data/marketpulse.db              # Docker overrides this to /app/data/marketpulse.db
AGGREGATOR_IGNORE_ORIGINS=replay,test
# BENCHMARK_US=^GSPC

# Legacy single-symbol worker only (realtime_worker.py); unused by the streaming stack
POLL_INTERVAL_SECONDS=60
